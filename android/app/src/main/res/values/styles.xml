<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#722640</item>
        <item name="colorPrimaryDark">#4f182c</item>
        <item name="colorAccent">#722640</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#16050F</item>
        <item name="android:statusBarColor">#16050F</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#16050F</item>
        <item name="android:statusBarColor">#16050F</item>
        <item name="android:windowBackground">#16050F</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#16050F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/velvet_splash_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">#16050F</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
